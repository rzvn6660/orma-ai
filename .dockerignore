# Exclude sensitive secrets and local environment variables
.env
.env.*
!.env.example

# Exclude local database files
*.db
*.db-journal
*.db-wal
*.db-shm
data/
data_prod/
backups/
*.meta.json
scratch/
backend/orma.db
backend/data/
backend/data_prod/
backend/backups/

# Exclude python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# Exclude temporary uploads and runtime directories
temp_audio/
temp_uploads/
uploads/
backend/temp_audio/
backend/temp_uploads/
backend/uploads/

# Exclude git and development IDE files
.git/
.github/
.vscode/
.idea/
*.log
