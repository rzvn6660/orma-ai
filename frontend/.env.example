# ORMA AI — Frontend Environment Configuration Example
# In production, set VITE_API_BASE_URL to your deployed HTTPS backend (e.g., https://orma-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth Web Client ID (Public)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
