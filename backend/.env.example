# ORMA AI — Backend Environment Configuration Example
# Copy this file to backend/.env and fill in your values.
# DO NOT commit backend/.env to source control.

# ==============================================================================
# 1. SERVER-ONLY SECRETS (NEVER EXPOSE TO FRONTEND / MOBILE CLIENTS)
# ==============================================================================

# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters

# Email Delivery (Gmail API over HTTPS)
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=your-dedicated-account@gmail.com

# ==============================================================================
# 2. SERVER OPERATIONAL CONFIGURATION
# ==============================================================================

# LLM Models Configuration
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Primary & Failover Defaults
PRIMARY_PROVIDER=gemini
SECONDARY_PROVIDER=groq

# Environment Mode ('development' or 'production')
ENVIRONMENT=development

# Database Configuration:
# - Leave DATABASE_URL unset/empty for local SQLite development (uses SQLITE_DB_PATH or backend/orma.db).
# - Set DATABASE_URL to a PostgreSQL connection string for Supabase production (e.g. Supabase Connection Pooler).
# Example Supabase: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage Configuration (Persistent Medical Document Storage)
# Required in production on Render Free (where container filesystem is ephemeral).
# For local development, leave unset to use local filesystem storage.
SUPABASE_URL=https://your-project-ref.supabase.co
# CRITICAL SECRET: Backend-only service role key. NEVER expose to frontend or commit to version control!
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-documents

# Local SQLite Database File Path (Used when DATABASE_URL is unset/empty)
# In development or local runs, optional override:
SQLITE_DB_PATH=
RAG_UPLOAD_DIR=

# ==============================================================================
# 3. PUBLIC / CLIENT-SAFE CONFIGURATION
# ==============================================================================

# Google OAuth Client ID (Public Web/Mobile Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Allowed Frontend URLs (CORS & Password Reset / Verification Links)
# In production, set to your production frontend URL (e.g. https://orma-ai.vercel.app)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# 4. BACKUP & DISASTER RECOVERY (OFF-SITE OBJECT STORAGE)
# ==============================================================================
# Automated backup frequency (in hours, default: 6)
BACKUP_INTERVAL_HOURS=6
# Persistent local backup storage directory (outside public web root)
BACKUP_DIR=/data/backups

# Off-site Cloud Object Storage (S3 / Cloudflare R2 / GCS)
# If left empty, local online backups are maintained without cloud replication.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


