# ORMA AI — Backend Environment Configuration Example
# Copy this file to backend/.env and fill in your values.
# DO NOT commit backend/.env to source control.

# ==============================================================================
# 1. SERVER-ONLY SECRETS (NEVER EXPOSE TO FRONTEND / MOBILE CLIENTS)
# ==============================================================================

# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters

# Email Delivery (Resend API or SMTP)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# SMTP Email Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_email@domain.com

# ==============================================================================
# 2. SERVER OPERATIONAL CONFIGURATION
# ==============================================================================

# LLM Models Configuration
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Primary & Failover Defaults
PRIMARY_PROVIDER=gemini
SECONDARY_PROVIDER=groq

# Environment Mode ('development' or 'production')
ENVIRONMENT=development

# Storage Paths (Optional: defaults to relative local paths in backend/)
# In production on persistent volumes, set e.g. SQLITE_DB_PATH=/data/orma.db
SQLITE_DB_PATH=
RAG_UPLOAD_DIR=

# ==============================================================================
# 3. PUBLIC / CLIENT-SAFE CONFIGURATION
# ==============================================================================

# Google OAuth Client ID (Public Web/Mobile Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Allowed Frontend URLs (CORS & Password Reset / Verification Links)
# In production, set to your production frontend URL (e.g. https://orma-ai.vercel.app)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

